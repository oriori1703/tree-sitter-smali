{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "smali",
      "camelcase": "Smali",
      "scope": "source.smali",
      "path": ".",
      "file-types": [
        "smali"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "smali"
    }
  ],
  "metadata": {
    "version": "1.0.0",
    "license": "MIT",
    "description": "Smali grammar for tree-sitter",
    "authors": [
      {
        "name": "Yotam Nachum",
        "email": "me@yotam.net"
      },
      {
        "name": "Amaan Qureshi",
        "email": "amaanq12@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter-grammars/tree-sitter-smali"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}